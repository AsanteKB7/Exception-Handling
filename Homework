
valid = False

while not valid:
    try:
        bill = float(input("Enter the bill amount: "))
        discount_percent = float(input("Enter the discount percent: "))
        people = int(input("Enter the number of people: "))

        discount_amount = bill * (discount_percent / 100)
        final_bill = bill - discount_amount
        each_person = final_bill / people

    except ValueError:
        print("Invalid input! Please type numbers only.")
    except ZeroDivisionError:
        print("Number of people cannot be 0. Please try again.")

    else:
        print(f"Final bill: ${final_bill}")
        print(f"Each person pays: ${each_person}")
        valid = True
    finally:
        print("Attempt finished.\n")
